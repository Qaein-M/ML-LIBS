import os
import re
import random
import requests
import numpy as np
import pandas as pd

TYPICAL_ELEMENTS = ['Fe', 'C', 'Si', 'Ni', 'Be']
WAVELENGTH_MIN = 200.0
WAVELENGTH_MAX = 600.0
RESOLUTION = 1000
GRID_STEP = 0.05
PLASMA_TEMP = 1
ELECTRON_DENSITY = 1e17
DATASET_DIR = "para2"
NUM_SAMPLES = 2

def generate_random_composition():
    num_elements = random.randint(2, 5)
    chosen_elements = random.sample(TYPICAL_ELEMENTS, num_elements)
    proportions = np.random.dirichlet(np.ones(num_elements), size=1)[0]
    percentages = [float(round(p * 100, 2)) for p in proportions]
    percentages[-1] = float(round(100.0 - sum(percentages[:-1]), 2))
    return dict(zip(chosen_elements, percentages))

def fetch_nist_spectrum(composition):
    base_url = "https://physics.nist.gov/cgi-bin/ASD/lines1.pl"
    elements, percentages = list(composition.keys()), list(composition.values())
    
    params = [
        ("composition", ";".join([f"{el}:{perc}" for el, perc in zip(elements, percentages)])),
        ("spectra", ",".join([f"{el}0-2" for el in elements])),
        ("low_w", str(WAVELENGTH_MIN)),
        ("upp_w", str(WAVELENGTH_MAX)),
        ("limits_type", "0"),
        ("show_av", "2"),
        ("unit", "1"),
        ("resolution", str(RESOLUTION)),
        ("temp", str(PLASMA_TEMP)),
        ("eden", str(ELECTRON_DENSITY)),
        ("maxcharge", "2"),
        ("min_rel_int", "0.01"),
        ("libs", "1")
    ]
    
    """parameters:
        composition: string in the format "Element1:Percentage1;Element2:Percentage2 (sum up to 100)
        spectra: min_charge to max_charge 
        low_w: lower wavelength limit
        upp_w: upper wavelength limit
        show_av: 2 for "Vacuum (< 200nm) Air (200-20000 nm) Vacuum (> 2000 nm)", 3 for "Vacuum (all wavelengths)"
        unit: 0 for angstroms, 1 for nanometers, 2 for micrometers
        temp: plasma electron temperature
        eden: plasma electron density 
        maxcharge: maximum ion charge
        min_rel_int: minimum relative intensity, filters out spectral lines below this threshold
        int_scale: 1 for "Energy flux", 2 for "Photon flux"
        libs: 1 to use LIBS data
        """
    
    for el, perc in zip(elements, percentages):
        params.extend([("mytext[]", el), ("myperc[]", str(perc))])

    response = requests.get(base_url, params=params)
    response.raise_for_status()
    page_source = response.text

    block_match = re.search(r'var\s+dataDopplerArray\s*=\s*\[(.*?)\]\s*;', page_source, re.DOTALL)
    
    if not block_match:
        if "No lines found" in page_source:
            raise ValueError("NIST found no emission lines for this system (try changing parameters).")
        raise ValueError("Could not find dataDopplerArray. The NIST page structure may have changed.")

    points = re.findall(r'\[\s*([+-]?[0-9.]+)\s*,\s*([+-]?[0-9.eE+-]+)\s*,', block_match.group(1))
    
    if not points:
        raise ValueError("Failed to parse coordinate points from the array.")
        
    return pd.DataFrame(points, columns=['wavelength', 'intensity']).astype(float)

def custom_interpolate(df_raw, min_w, max_w, step):
    df_raw = df_raw.dropna().sort_values('wavelength')
    custom_grid = np.round(np.arange(min_w, max_w + (step/2), step), decimals=2)
    
    interpolated_intensities = np.interp(
        custom_grid, 
        df_raw['wavelength'], 
        df_raw['intensity'],
        left=0, 
        right=0
    )
    
    return pd.DataFrame({
        'wavelength': custom_grid,
        'intensity': np.round(interpolated_intensities, 4)
    })

def main():
    os.makedirs(DATASET_DIR, exist_ok=True)
    print(f"Generating {NUM_SAMPLES} spectra...\n")
    metadata = []
    
    for i in range(1, NUM_SAMPLES + 1):
        comp = generate_random_composition()
        filename = "_".join([f"{el}{perc}" for el, perc in comp.items()]) + ".csv"
        
        print(f"[{i}/{NUM_SAMPLES}] Generating: {filename}")
        
        try:
            df_raw = fetch_nist_spectrum(comp)
            df_final = custom_interpolate(df_raw, WAVELENGTH_MIN, WAVELENGTH_MAX, GRID_STEP)
            
            df_final.to_csv(os.path.join(DATASET_DIR, filename), index=False)
            
            row = {'sample_id': filename}
            row.update({el: comp.get(el, 0.0) for el in TYPICAL_ELEMENTS})
            metadata.append(row)
            
        except Exception as e:
            print(f"--> Error with sample {i}: {e}")
            
    if metadata:
        pd.DataFrame(metadata).to_csv(os.path.join(DATASET_DIR, "Elements_labels.csv"), index=False)
        print(f"\nFinished successfully. Data is in folder: '{DATASET_DIR}'")

if __name__ == "__main__":
    main()
